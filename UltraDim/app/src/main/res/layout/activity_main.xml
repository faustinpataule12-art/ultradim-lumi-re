<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0A0A16"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UltraDim"
        android:textColor="#EEF0FF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Réduit fortement la luminosité perçue, même en dehors de l'app"
        android:textColor="#888AAC"
        android:textSize="13sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Autoriser l'affichage par-dessus les autres applis"
        android:layout_marginBottom="16dp"
        android:visibility="visible" />

    <TextView
        android:id="@+id/tvPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#00E5FF"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Le filtre reste toujours plafonné : l'écran ne devient jamais totalement noir ni invisible."
        android:textColor="#6E7090"
        android:textSize="11sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="28dp" />

    <Button
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Activer le filtre" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:textColor="#888AAC"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#6E7090"
        android:textSize="11sp"
        android:text="Astuce : ajoute la tuile UltraDim dans tes réglages rapides (glisser vers le bas → crayon/modifier) pour l'activer en un tap." />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Créé par NPS.NELSON"
        android:textColor="#6E7090"
        android:textSize="11sp" />

</LinearLayout>
